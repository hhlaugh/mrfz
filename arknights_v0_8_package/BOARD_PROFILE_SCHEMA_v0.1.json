{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arknights/board-profile-0.1.schema.json",
  "title": "Arknights BoardProfile 0.1",
  "type": "object",
  "required": [
    "schema_version",
    "board_id",
    "mode",
    "sides",
    "route_groups",
    "victory"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "board_id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "duel",
        "siege"
      ]
    },
    "sides": {
      "type": "object",
      "required": [
        "p1",
        "p2"
      ],
      "additionalProperties": false,
      "properties": {
        "p1": {
          "$ref": "#/$defs/side"
        },
        "p2": {
          "$ref": "#/$defs/side"
        }
      }
    },
    "route_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/routeGroup"
      }
    },
    "victory": {
      "$ref": "#/$defs/victory"
    },
    "ui": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "side": {
      "type": "object",
      "required": [
        "base_hp",
        "lanes"
      ],
      "additionalProperties": false,
      "properties": {
        "side_label": {
          "type": "string"
        },
        "base_hp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/lane"
          }
        }
      }
    },
    "lane": {
      "type": "object",
      "required": [
        "lane_id",
        "lane_order",
        "front_slots",
        "back_slots"
      ],
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "type": "string",
          "minLength": 1
        },
        "lane_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "front_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "back_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      },
      "anyOf": [
        {
          "properties": {
            "front_slots": {
              "minimum": 1
            }
          }
        },
        {
          "properties": {
            "back_slots": {
              "minimum": 1
            }
          }
        }
      ]
    },
    "routeGroup": {
      "type": "object",
      "required": [
        "route_group_id",
        "side_lanes"
      ],
      "additionalProperties": false,
      "properties": {
        "route_group_id": {
          "type": "string",
          "minLength": 1
        },
        "side_lanes": {
          "type": "object",
          "required": [
            "p1",
            "p2"
          ],
          "additionalProperties": false,
          "properties": {
            "p1": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "p2": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "victory": {
      "type": "object",
      "required": [
        "first_player",
        "attacker_side",
        "defender_side",
        "round_limit"
      ],
      "additionalProperties": false,
      "properties": {
        "first_player": {
          "enum": [
            "p1",
            "p2",
            "random"
          ]
        },
        "attacker_side": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "p1",
            "p2",
            null
          ]
        },
        "defender_side": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "p1",
            "p2",
            null
          ]
        },
        "round_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 30
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "duel"
          }
        }
      },
      "then": {
        "properties": {
          "victory": {
            "properties": {
              "attacker_side": {
                "type": "null"
              },
              "defender_side": {
                "type": "null"
              },
              "round_limit": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "siege"
          }
        }
      },
      "then": {
        "properties": {
          "victory": {
            "properties": {
              "attacker_side": {
                "enum": [
                  "p1",
                  "p2"
                ]
              },
              "defender_side": {
                "enum": [
                  "p1",
                  "p2"
                ]
              },
              "round_limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              }
            }
          }
        }
      }
    }
  ]
}